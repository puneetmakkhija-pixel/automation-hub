# IVR Router Configuration
PORT=3000

# ==================== OBD API Configuration ====================
OBD_BASE_URL=https://obdapi2.ivrsms.com
OBD_USERNAME=your_obd_username
OBD_PASSWORD=your_obd_password

# ==================== Ananta WhatsApp Configuration ====================
ANANTA_API_KEY=your_ananta_api_key_for_sending
ANANTA_API_TOKEN=your_ananta_api_token_for_data_api
ANANTA_API_SECRET_KEY=your_ananta_api_secret_key
ANANTA_DATA_BASE_URL=https://data-api.anantadot.com
ANANTA_UTILS_BASE_URL=https://utilsapi.anantadot.com

# ==================== Oriserve Voice Agent Configuration ====================
ORISERVE_API_KEY=your_oriserve_api_key
ORISERVE_BASE_URL=https://api-voice-agent.oriserve.com/api/v1
ORISERVE_WEBHOOK_URL=https://your-domain.com/webhooks/oriserve

# ==================== Supabase Configuration ====================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================== Eleven Labs Configuration ====================
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key
ELEVEN_LABS_BASE_URL=https://api.elevenlabs.io/v1

# ==================== Webhook URLs ====================
OBD_WEBHOOK_URL=https://your-domain.com/webhooks/obd
ANANTA_WEBHOOK_URL=https://your-domain.com/webhooks/ananta
ORISERVE_WEBHOOK_URL=https://your-domain.com/webhooks/oriserve
SUPABASE_WEBHOOK_URL=https://your-domain.com/api/db/webhooks/log
