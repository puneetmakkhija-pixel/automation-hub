# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cron Status Monitoring - Alerting Configuration (Optional)
# Email alerts for job failures and overdue jobs
ALERT_EMAIL=ops@yourdomain.com

# Slack integration for status updates
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Job-specific API Configuration
DIGITAP_API_KEY=your_digitap_api_key
DIGITAP_API_BASE_URL=https://api.digitap.ai
