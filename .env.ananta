# Ananta WhatsApp Configuration
# Copy to .env and fill in your credentials

# Ananta API Endpoint (default: https://api.ananta.io/v1/messages/send)
ANANTA_API_ENDPOINT=https://api.ananta.io/v1/messages/send

# Ananta API Key (from your Ananta Dashboard)
ANANTA_API_KEY=your_ananta_api_key_here

# Your Ananta WhatsApp Phone Number
ANANTA_PHONE_NUMBER=+91XXXXXXXXXX

# Ananta Account ID
ANANTA_ACCOUNT_ID=your_account_id

# Webhook URL for delivery notifications (optional)
ANANTA_WEBHOOK_URL=https://automation-hub.local/api/webhooks/ananta/status

# Enable debug logging
ANANTA_DEBUG=false
