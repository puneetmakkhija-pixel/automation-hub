# Server Configuration
PORT=3000

# OBD IVR SMS API Configuration
OBD_BASE_URL=https://obdapi2.ivrsms.com
OBD_USERNAME=your_obd_username
OBD_PASSWORD=your_obd_password

# Webhook Configuration for OBD API callbacks
OBD_WEBHOOK_URL=https://your-domain.com/webhooks/obd
OBD_SMS_WEBHOOK_URL=https://your-domain.com/webhooks/sms

# Supabase Configuration (Phase 3a: Conversation State Management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Ananta WhatsApp and Customer Data API Configuration
ANANTA_BASE_URL=https://data-api.anantadot.com
ANANTA_API_KEY=your_ananta_api_key
ANANTA_API_TOKEN=your_ananta_api_token
ANANTA_API_SECRET_KEY=your_ananta_api_secret_key

# Redis Configuration (Phase 3.5: Job Queues)
REDIS_URL=redis://localhost:6379

# Claude API (Phase 3.5a: Intent Generation)
CLAUDE_API_KEY=sk-ant-...

# SendGrid Email (Phase 3.5b: Application Push)
SENDGRID_API_KEY=SG.xxxxx...
SENDGRID_FROM_EMAIL=support@buddyloan.com

# Slack Webhooks (Phase 3.5b: Application Push - Ops Alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Twilio number that points its Voice webhook at https://<this-service>.up.railway.app/voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_IVR_NUMBER=

# If handing off to an ElevenLabs conversational agent instead of scripted TwiML
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# BRE Shortlisting Configuration (Daily Base Filtering)
# No additional env vars required - uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above

# Lender MIS Feedback Configuration (Webhook Signatures)
POONAWALLA_MIS_SECRET=your_poonawalla_webhook_secret_key
HERO_FINCORP_MIS_SECRET=your_hero_fincorp_webhook_secret_key

# Logging
LOG_LEVEL=info
