# Server Configuration
PORT=3000

# OBD IVR SMS API Configuration
OBD_BASE_URL=https://obdapi2.ivrsms.com
OBD_USERNAME=your_obd_username
OBD_PASSWORD=your_obd_password

# Webhook Configuration for OBD API callbacks
OBD_WEBHOOK_URL=https://your-domain.com/webhooks/obd
OBD_SMS_WEBHOOK_URL=https://your-domain.com/webhooks/sms

# Supabase Configuration (Phase 3a: Conversation State Management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Ananta WhatsApp and Customer Data API Configuration
ANANTA_BASE_URL=https://data-api.anantadot.com
ANANTA_API_KEY=your_ananta_api_key
ANANTA_API_TOKEN=your_ananta_api_token
ANANTA_API_SECRET_KEY=your_ananta_api_secret_key

# Redis Configuration (Phase 3.5: Job Queues)
REDIS_URL=redis://localhost:6379

# Claude API (Phase 3.5a: Intent Generation)
CLAUDE_API_KEY=sk-ant-...

# SendGrid Email (Phase 3.5b: Application Push)
SENDGRID_API_KEY=SG.xxxxx...
SENDGRID_FROM_EMAIL=support@buddyloan.com

# Slack Webhooks (Phase 3.5b: Application Push - Ops Alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Twilio number that points its Voice webhook at https://<this-service>.up.railway.app/voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_IVR_NUMBER=

# If handing off to an ElevenLabs conversational agent instead of scripted TwiML
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# BRE Shortlisting Configuration (Daily Base Filtering)
# No additional env vars required - uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above

# Lender MIS Feedback Configuration (Webhook Signatures)
POONAWALLA_MIS_SECRET=your_poonawalla_webhook_secret_key
HERO_FINCORP_MIS_SECRET=your_hero_fincorp_webhook_secret_key

# Logging
LOG_LEVEL=info

# Ananta shortens every URL in the message before sending it, rewriting the
# lender journey link to op2.in/wt/<code>. ON unless set to 0: the
# Poonawalla Fincorp URL is ~190 characters of DSA code and UTM parameters,
# which wraps over three lines on a phone and reads like spam.
#
# The click is then recorded in Ananta's panel rather than our send log. Their
# Click URL webhook can post those opens back — see ANANTA_QUICK_START.md.
ANANTA_IS_SHORT_URL=1

# Per-lender application link, one variable per campaign variant.
#
#   IVR_LINK_<VARIANT>   e.g. IVR_LINK_HEROFINCORP=https://loans.apps.herofincorp.com/...
#
# The variant is the webhook suffix the IVR panel posts to
# (/webhooks/ivr/whatsapp/herofincorp -> IVR_LINK_HEROFINCORP; a dash or dot in
# the variant becomes an underscore). Wins over IVR_VARIANT_PLACEHOLDERS, which
# wins over IVR_DTMF_PLACEHOLDERS.
#
# Only the LINK goes here. How many placeholders the template wants is taken
# from IVR_DTMF_PLACEHOLDERS and the last one replaced, so the count always
# matches the template the default campaign already sends with.
#
# Prefer this over adding a key to IVR_VARIANT_PLACEHOLDERS: that variable is a
# nested JSON object edited by hand, and one stray comma makes it unparseable —
# at which point EVERY variant silently falls back to the default link, which
# looks exactly like the variant never having been configured.
IVR_LINK_HEROFINCORP=

# Secret offset behind {{alias}} — the mobile transformed for affiliate sub-IDs,
# so a phone number never reaches whistleloop, the publisher account, or any
# redirect in between. Ten digits.
#
# The lender-MIS recon formula needs this SAME value, and there is no recovery
# path but re-deriving it from a known (mobile, alias) pair — keep it wherever
# the recon sheet lives:
#
#   =TEXT(MOD(DECIMAL(UPPER(RIGHT(A2,7)),36)-$B$1,10^10),"0000000000")
#
# Unset means an offset of zero, which still round-trips but is trivially
# reversible by anyone. See lib/mobileAlias.js.
IVR_ALIAS_KEY=

# How many press-1s this service works on at once. Default 8; leave it unset
# unless there is a reason.
#
# On 17 Sep 2026 campaign 1193640 put 227 presses into this webhook inside one
# minute. Express ran all 227 at once, each holding a database connection while
# waiting on a ten-second HTTP timeout, and Supabase ran out of pool — 522 from
# Cloudflare, "Timed out acquiring connection from connection pool", and then
# "Could not record send" for messages that HAD gone out. 99 of 426 callers
# ended the minute with no row of any kind.
#
# Eight is a quarter of Supabase's sixty-connection pool at peak, which leaves
# room for the CRM crons, the cockpit and pg_net to keep working while a burst
# drains. Raising it drains faster and gives the database less headroom; there
# is no point raising it without watching the pool at the same time.
IVR_PRESS_CONCURRENCY=

# How many presses may WAIT for a slot before the service starts refusing them.
# Default 500. A queue with no ceiling is a slower way to run out of memory,
# and a press that has been waiting minutes is worthless — the caller hung up.
# 0 refuses all queueing and is honoured as such.
IVR_PRESS_QUEUE_LIMIT=
