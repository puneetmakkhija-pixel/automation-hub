# Dedicated image for the voice-outcome-poll Railway service (root directory
# ivr-router, dockerfilePath set to this file via the Railway API).
#
# NOT ivr-router/Dockerfile: that one is the always-on web server's image and
# doesn't COPY scripts/, so a service built from it can't run
# `npm run voice-poll:cron` -- it built fine and then crashed at runtime with
# a missing module. Discovered that way, on the first live deploy of this
# service, 28 Sep 2026.
#
# Also not a railway.toml builder override: setting one via the Railway API
# is refused outright ("Config as Code (railway.json / railway.toml) is
# deprecated"), and a committed ivr-router/railway.toml setting
# builder = "railpack" was silently never honored -- two deploys from it
# produced the byte-identical Docker image. Do not re-add one; use
# dockerfilePath on the service instead, which is what actually took effect.
#
# node:22, not node:18 like the web server's Dockerfile: @supabase/supabase-js
# 2.112.4 needs Node 22+ for its realtime transport's native WebSocket. On 18
# the build succeeds (npm only warns EBADENGINE) but pollVoiceOutcomes()
# swallows the resulting "native WebSocket not found" as a per-run error and
# reports {polled:0, updated:0, ...} every tick -- deployed and running, doing
# nothing, discovered by reading the deploy log rather than trusting a
# successful build. The web server's own Node 18 image is untouched; this
# service is standalone and can move independently.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit
COPY lib ./lib
COPY scripts ./scripts
CMD ["npm", "run", "voice-poll:cron"]
