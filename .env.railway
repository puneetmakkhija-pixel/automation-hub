# ==================== CRITICAL: Oriserve Voice Bot (ORI) ====================
# ORISERVE_API_KEY is a live credential and is deliberately NOT in this file.
# Set it on the Railway service only — see ivr-router/ORI_VOICE_BOT_CAMPAIGN.md:
#   railway variables --set "ORISERVE_API_KEY=vx_..."
ORISERVE_BASE_URL=https://api-buddy-loan-vox.oriserve.com/api/v1
ORISERVE_CAMPAIGN_ID=6a969a1c91b08220629d6b88
ORISERVE_WEBHOOK_URL=https://ivr-voice-bot-system-production.up.railway.app/webhooks/oriserve
# ORISERVE_WEBHOOK_SECRET is a live credential and is not in this file. Set it
# on the Railway service, but only once Oriserve is sending it — the check
# fails OPEN while unset, so setting it early rejects genuine callbacks:
#   railway variables --set "ORISERVE_WEBHOOK_SECRET=..." 

# ==================== Ananta WhatsApp (Complete Setup) ====================
ANANTA_API_TOKEN=your_ananta_api_token
ANANTA_API_SECRET_KEY=your_ananta_api_secret_key
ANANTA_UTILS_BASE_URL=https://utilsapi.anantadot.com
ANANTA_PHONE_NUMBER=your_ananta_phone_sender_id

# ==================== Webhook URLs (Production) ====================
OBD_WEBHOOK_URL=https://ivr-voice-bot-system-production.up.railway.app/webhooks/obd
OBD_SMS_WEBHOOK_URL=https://ivr-voice-bot-system-production.up.railway.app/webhooks/sms
ANANTA_WEBHOOK_URL=https://ivr-voice-bot-system-production.up.railway.app/webhooks/ananta
# SUPABASE_WEBHOOK_URL is gone: it pointed at /api/db/webhooks/log, which PR #40
# retired along with the rest of /api/db. See docs/RETIRED_ENDPOINTS.md.

# ==================== Logging & Environment ====================
LOG_LEVEL=debug
NODE_ENV=production
